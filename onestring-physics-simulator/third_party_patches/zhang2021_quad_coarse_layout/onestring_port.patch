+// linked here; only the identifiers referenced by ChartDeformation.cpp are
+// declared (values from mosek.h 7.1).  The function is defined by
+// mosek_stub/ConvexQuadOptimizationStub.cpp and aborts if ever called; it is
+// not reachable from the Zhang 2021 straightening path.
+#ifndef CONVEX_QUAD_OPRIMIZATION_H
+#define CONVEX_QUAD_OPRIMIZATION_H
+
+#include <vector>
+
