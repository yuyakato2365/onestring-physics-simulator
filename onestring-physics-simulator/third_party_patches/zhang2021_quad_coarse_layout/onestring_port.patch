diff --git a/CMakeLists.txt b/CMakeLists.txt
new file mode 100644
index 0000000..fd70d8a
--- /dev/null
+++ b/CMakeLists.txt
@@ -0,0 +1,60 @@
+# OneString portability build for the authors' reference implementation of
+#   C. Zhang, S. Chai, L. Liu, X.-M. Fu,
+#   "Quad meshing with coarse layouts for planar domains", CAD 140 (2021) 103084.
+# Only build-system / platform-compatibility files live in onestring_port/.
+cmake_minimum_required(VERSION 3.16)
+project(zhang2021_quad_coarse_layout CXX C)
+
+set(CMAKE_CXX_STANDARD 14)
+set(CMAKE_CXX_STANDARD_REQUIRED ON)
+if(NOT CMAKE_BUILD_TYPE)
+  set(CMAKE_BUILD_TYPE Release)
+endif()
+
+find_package(Eigen3 3.3 REQUIRED NO_MODULE)
+find_package(OpenMP)
+# CGAL (header-only >= 5.0; needs Boost, GMP, MPFR) is used by the authors'
+# CGAL_AABBTree.h in Segment and QMSim.
+find_package(CGAL REQUIRED)
+if(NOT OpenMP_CXX_FOUND)
+  message(WARNING "OpenMP not found: Segment is built WITHOUT OpenMP, unlike the "
+                  "authors' Release|x64 build (results stay valid but may differ "
+                  "in floating-point summation order). On macOS: brew install libomp "
+                  "and pass -DOpenMP_ROOT=$(brew --prefix libomp).")
+endif()
+
+set(Z21_ROOT ${CMAKE_CURRENT_SOURCE_DIR})
+set(Z21_PORT ${Z21_ROOT}/onestring_port)
+
+# ---------------------------------------------------------------- OpenMesh 7.1
+# The authors bundle OpenMesh 7.1 sources; compile its Core as a static lib.
+set(OM_ROOT ${Z21_ROOT}/Segment/ThirdParty/include)
+file(GLOB_RECURSE OM_CC ${OM_ROOT}/OpenMesh/Core/*.cc)
+list(FILTER OM_CC EXCLUDE REGEX ".*T\\.cc$")
+list(FILTER OM_CC EXCLUDE REGEX ".*/Templates/.*")
+add_library(z21_openmesh STATIC ${OM_CC})
+target_include_directories(z21_openmesh PUBLIC ${OM_ROOT})
+target_compile_definitions(z21_openmesh PUBLIC _USE_MATH_DEFINES OM_STATIC_BUILD)
+set_target_properties(z21_openmesh PROPERTIES POSITION_INDEPENDENT_CODE ON)
+
+# --------------------------------------------------------------------- ANN 1.1
+file(GLOB ANN_CPP ${OM_ROOT}/ANN/*.cpp)
+add_library(z21_ann STATIC ${ANN_CPP})
+target_include_directories(z21_ann PUBLIC ${OM_ROOT} ${OM_ROOT}/ANN)
+
+function(z21_common target)
+  target_include_directories(${target} PRIVATE ${Z21_PORT}/include)
+  target_link_libraries(${target} PRIVATE z21_openmesh z21_ann Eigen3::Eigen)
+  target_compile_definitions(${target} PRIVATE _USE_MATH_DEFINES NDEBUG Z21_ONESTRING_PORT)
+  target_compile_options(${target} PRIVATE -include ${Z21_PORT}/include/z21_compat.h)
+endfunction()
+
+# OpenMP is enabled exactly where the authors' Release|x64 projects enable it:
+# Segment.vcxproj (OpenMPSupport=true); QuadMeshSimplify.vcxproj and
+# Straighten.vcxproj build without OpenMP (pragmas ignored -> serial,
+# deterministic reductions).  Floating-point contraction is disabled to match
+# MSVC /fp:precise without /arch:AVX2 (no FMA).
+add_compile_options(-ffp-contract=off)
+add_subdirectory(onestring_port/segment)
+add_subdirectory(onestring_port/qmsim)
+add_subdirectory(onestring_port/straighten)
