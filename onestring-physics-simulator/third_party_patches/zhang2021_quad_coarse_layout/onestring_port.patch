diff --git a/onestring_port/include/z21_compat.h b/onestring_port/include/z21_compat.h
new file mode 100644
index 0000000..8ad7c7e
--- /dev/null
+++ b/onestring_port/include/z21_compat.h
@@ -0,0 +1,68 @@
+// OneString portability prelude, force-included (-include) into every
+// translation unit of the authors' Zhang et al. (CAD 2021) reference code.
+//
+// MSVC makes many standard headers transitively available; GCC/Clang do not.
+// This header only adds standard-library declarations and a few Windows CRT
+// spellings.  It contains no algorithmic code.
+#pragma once
+
+#ifdef __cplusplus
+#include <algorithm>
+#include <array>
+#include <cassert>
+#include <cfloat>
+#include <climits>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <ctime>
+#include <functional>
+#include <iostream>
+#include <iterator>
+#include <limits>
+#include <list>
+#include <map>
+#include <memory>
+#include <numeric>
+#include <queue>
+#include <set>
+#include <stack>
+#include <string>
+#include <tuple>
+#include <unordered_map>
+#include <unordered_set>
+#include <utility>
+#include <vector>
+
+// MSVC's <windows.h>/<minwindef.h> provide unqualified min/max that several
+// authors' files call without `std::` (e.g. `max(targetQuadNum, 1)`).
+using std::max;
+using std::min;
+// IMPORTANT numerical portability fix: with MSVC, <cmath> places the
+// floating-point overloads of abs() in the global namespace, so the authors'
+// unqualified `abs(det_u)` on doubles computes |x|.  With libstdc++/libc++,
+// the unqualified call resolves to C's `int abs(int)` and silently truncates
+// (abs(-0.3) == 0).  Re-expose std::abs overloads globally (MSVC semantics).
+using std::abs;
+#endif
+
+#ifndef _WIN32
+#define __int64 long long
+// POSIX <limits.h> defines LINE_MAX; ParaQuadCutting.cpp uses it as a local
+// variable name (valid with the MSVC CRT, which has no such macro).
+#ifdef LINE_MAX
+#undef LINE_MAX
+#endif
+#endif
+
+#ifdef __cplusplus
+// MSVC (non-conforming extension) lets a temporary bind to a non-const lvalue
+// reference, e.g. default arguments `std::vector<double>& g = std::vector<double>()`.
+// z21_lvalue() yields an lvalue designating the same temporary, which lives
+// until the end of the full-expression containing the call -- exactly the
+// lifetime MSVC gives it.  Used only to make such declarations ISO C++.
+template <class T>
+inline T& z21_lvalue(T&& t) { return t; }
+#endif
