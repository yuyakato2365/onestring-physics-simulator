+// OneString portability: MOSEK 7.1 (commercial) is linked by the authors'
+// Straighten.exe only for AAAtlas' axis-aligned PolySquare "segment
+// flattening" (ChartDeformation::mosek_flattening).  Zhang et al.'s boundary
+// straightening path (ChartDeformation::deformation / deformation_with_hole)
+// never calls it.  Fail loudly if that ever changes.
+#include "Mosek/ConvexQuadOptimization.h"
+#include <cstdio>
+#include <cstdlib>
+
+bool solveConvexQuadPorgramming_mosek(std::vector<MSKboundkeye>&, std::vector<double>&, std::vector<double>&,
+	std::vector<MSKboundkeye>&, std::vector<double>&, std::vector<double>&,
+	std::vector<MSKlidxt>&, std::vector<MSKidxt>&, std::vector<double>&,
+	std::vector<MSKidxt>&, std::vector<MSKidxt>&, std::vector<double>&, std::vector<double>&,
+	std::vector<double>&, bool)
+{
+	std::fprintf(stderr, "[z21_straighten] FATAL: MOSEK segment flattening is not part of the "
+		"Zhang 2021 straightening path and is unavailable in the OneString port.\n");
+	std::abort();
+}
