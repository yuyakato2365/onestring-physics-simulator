+set(ST_DIR ${Z21_ROOT}/Straighten/Straighten)
+# Non-GUI translation units of the authors' Straighten.vcxproj.
+# Excluded (GUI only): AAAtlas.cpp, MeshViewer/{InteractiveViewerWidget,
+# MainViewerWidget, MeshParamDialog, MeshViewerWidget, QGLViewerWidget,
+# Auxiliary_Function_Mesh}.cpp, ProcessContainer.cpp, main.cpp,
+# Common/TimeProfiler.cpp.  Replaced: include/Mosek/ConvexQuadOptimization.cpp
+# (commercial MOSEK; unreachable in the straightening path) and
+# Scaffold/PardisoSolver.cpp (MKL PARDISO) by Eigen.  The batch driver
+# onestring_port/straighten/headless_main.cpp replicates main.cpp +
+# ProcessContainer + InteractiveViewerWidget's batch methods.
+set(ST_SOURCES
+  AssistFunc.cpp ChartDeformation.cpp ChartDeformation_Deform.cpp ChartUntangle.cpp
+  Common/CommonDefinitions.cpp Common/VKString.cpp Common/VKStringList.cpp
+  MeshViewer/MeshDefinition.cpp MeshViewer/Mesh_doubleIO.cpp
+  MyAnderson.cpp MyParafun.cpp MyParaQuadCutting.cpp
+  Optimization/HLBFGS/HLBFGS.cpp Optimization/HLBFGS/HLBFGS_BLAS.cpp
+  Optimization/HLBFGS/ICFS.cpp Optimization/HLBFGS/LineSearch.cpp
+  Optimization/HLBFGS/Lite_Sparse_Matrix.cpp Optimization/Numeric/FastMath.cpp
+  ParaQuadChartDecomposition.cpp ParaQuadCutting.cpp PolySquareDeformation.cpp
+  Scaffold/Parafun.cpp Scaffold/ScafCommon.cpp Scaffold/ScafData.cpp
+  Scaffold/StateManager.cpp Scaffold/TriangleInterface.cpp
+  Viewer2D.cpp Viewer2D_Parameterization.cpp Viewer2D_Segments.cpp)
+list(TRANSFORM ST_SOURCES PREPEND ${ST_DIR}/)
+
+file(GLOB ST_ANN_CPP ${ST_DIR}/include/ANN/*.cpp)
+add_library(z21_st_ann STATIC ${ST_ANN_CPP})
+target_include_directories(z21_st_ann PUBLIC ${ST_DIR}/include)
+
+# Shewchuk's Triangle (bundled), compiled as a library like the authors'
+# triangle.lib.
+add_library(z21_triangle STATIC ${ST_DIR}/include/triangle/triangle.c)
+target_compile_definitions(z21_triangle PRIVATE TRILIBRARY ANSI_DECLARATORS REAL=double VOID=int NO_TIMER "__int64=long long")
+set_target_properties(z21_triangle PROPERTIES LINKER_LANGUAGE C)
+
+add_executable(z21_straighten ${ST_SOURCES}
+  ${Z21_PORT}/straighten/headless_main.cpp
+  ${Z21_PORT}/straighten/shim/mosek_stub/ConvexQuadOptimizationStub.cpp
+  ${Z21_PORT}/src/PardisoSolverEigen.cpp)
+# Order matters: shim first (headless Qt, empty CHOLMOD/MKL headers), then
+# the authors' tree and its bundled Eigen 3.3.5 / OpenMesh 7.1.
+target_include_directories(z21_straighten BEFORE PRIVATE
+  ${Z21_PORT}/straighten/shim
+  ${ST_DIR} ${ST_DIR}/Scaffold ${ST_DIR}/include ${ST_DIR}/include/Eigen
+  ${ST_DIR}/Optimization/HLBFGS ${ST_DIR}/Optimization/Numeric ${ST_DIR}/Common
+  ${ST_DIR}/include/rectpack2D/src)
+target_include_directories(z21_straighten PRIVATE ${Z21_PORT}/include)
+target_link_libraries(z21_straighten PRIVATE z21_openmesh z21_st_ann z21_triangle)
+target_compile_definitions(z21_straighten PRIVATE _USE_MATH_DEFINES NDEBUG Z21_ONESTRING_PORT)
+target_compile_options(z21_straighten PRIVATE -include ${Z21_PORT}/include/z21_compat.h)
+# rectpack2D (used by the authors' ParaQuadCutting) requires C++17.
+set_target_properties(z21_straighten PROPERTIES CXX_STANDARD 17)
+# Clang rejects the authors' narrowing brace initialisers (long -> int in
+# ParaQuadChartDecomposition.cpp); MSVC/GCC accept them with the identical
+# implicit conversion, so only the diagnostic is relaxed.
+if(CMAKE_CXX_COMPILER_ID MATCHES "Clang")
+  target_compile_options(z21_straighten PRIVATE -Wno-c++11-narrowing)
+endif()
diff --git a/onestring_port/straighten/headless_main.cpp b/onestring_port/straighten/headless_main.cpp
new file mode 100644
index 0000000..1052294
--- /dev/null
+++ b/onestring_port/straighten/headless_main.cpp
@@ -0,0 +1,403 @@
+// OneString portability: headless driver for the authors' Straighten step.
+//
+// The authors' Straighten.exe (Code/Straighten/Straighten/main.cpp) builds a
+// Qt QApplication and a MainViewerWidget only to host the mesh; the batch
+// pipeline (WholePipeline.bat) never shows a window.  This file replicates,
+// statement by statement, the code that main.cpp executes through
+// ProcessContainer -> MainViewerWidget::MeshViewer (InteractiveViewerWidget):
+//
+//   OpenMesh(argv[1]) : MeshViewerWidget::openMesh + load_parameterization
+//   Preprocess()      : InteractiveViewerWidget::pre_process
+//   saveNewMesh(argv[2])
+//   DoAlgorithm()     : InteractiveViewerWidget::polysquare
+//   DoAlgorithmWithHole() : InteractiveViewerWidget::polysquareWithHole
+//   saveNewMesh(argv[3])
+//
+// The bodies below are copied from MeshViewer/MeshViewerWidget.{h,cpp} and
+// MeshViewer/InteractiveViewerWidget.{h,cpp}; only Qt rendering / signal
+// statements (updateGL, emit, QFileInfo, system("CLS")) are removed or
+// replaced by std equivalents.  The default parameters are those of the
+// InteractiveViewerWidget constructor (kernel_width = 0.08, etc.).
+
+#include "ParaQuadCutting.h"
+#include "PolySquareDeformation.h"
+#include "AssistFunc.h"
+#include "MeshViewer/Mesh_doubleIO.h"
+
+#include <ctime>
+#include <fstream>
+#include <iostream>
+#include <limits>
+#include <memory>
+#include <set>
+#include <string>
+#include <vector>
+
+#include <cstdlib>
+#include <climits>
+
+namespace {
+
+std::string dir_of(const std::string& path)
+{
+	auto p = path.find_last_of("/\\");
+	return p == std::string::npos ? std::string(".") : path.substr(0, p);
+}
+
+std::string absolute_of(const std::string& path)
+{
+	char buf[PATH_MAX];
+	if (::realpath(path.c_str(), buf)) return std::string(buf);
+	return path;
+}
+
+} // namespace
+
+class HeadlessStraightenViewer
+{
+public:
+	// ---- InteractiveViewerWidget defaults (constructor + in-class init) ----
+	double kernel_width = 0.08;
+	double goal_factor = 0.1;
+	double energy_exp_factor = 1.0;
+	double split_thres = 0.02;
+	double pe_bound = 0.8;
+	double input_distortion = 0.0;
+	double chart_gap = 2.0;
+	std::string my_file_name;
+	double M_PE = 0.0;
+
+	std::vector<std::string> para_viewer_titles;
+	std::unique_ptr<ParaQuadCutting> para_cutting = nullptr;
+	std::unique_ptr<PolySquareDeformation> poly_info = nullptr;
+	int current_phase = 0;
+
+	// ---- MeshViewerWidget state ----
+	OpenMesh::Vec3d bbMin, bbMax;
+	std::vector<Mesh> mesh_vector;
+	int mesh_vector_index = -1;
+	std::string str_pathname, str_filepath, str_filename;
+	std::vector<int> new_boundary_vertices;
+	Mesh mesh;
+	Mesh::Scalar mesh_avg_length = 0, edge_offset = 0;
+	OpenMesh::EPropHandleT<bool> e_oncut;
+	std::vector<int> selectedVertex, selectedFace, selectedEdge;
+
+	// MeshViewerWidget::clearAllMesh / InteractiveViewerWidget::clearAllMesh
+	void clearSelectedData()
+	{
+		selectedVertex.clear();
+		selectedFace.clear();
+		selectedEdge.clear();
+	}
+	void clearAllMesh()
+	{
+		clearSelectedData();
+		para_cutting.reset(nullptr);
+		poly_info.reset(nullptr);
+		mesh_vector.clear(); mesh_vector_index = -1;
+		mesh = Mesh();
+	}
+
+	// MeshViewerWidget::init_properties
+	void init_properties()
+	{
+		if (!mesh.get_property_handle(e_oncut, "e_oncut")) mesh.add_property(e_oncut, "e_oncut");
+
+		for (auto e_h : mesh.edges())
+		{
+			mesh.property(e_oncut, e_h) = mesh.is_boundary(e_h);
+		}
+	}
+
+	// MeshViewerWidget::updateMeshCenter (bounding box and edge statistics)
+	void updateMeshCenter()
+	{
+		Mesh::VertexIter vIt = mesh.vertices_begin();
+		Mesh::VertexIter vEnd = mesh.vertices_end();
+		bbMin = bbMax = OpenMesh::vector_cast<OpenMesh::Vec3d>(mesh.point(*vIt));
+		for (; vIt != vEnd; ++vIt)
+		{
+			bbMin.minimize(OpenMesh::vector_cast<OpenMesh::Vec3d>(mesh.point(*vIt)));
+			bbMax.maximize(OpenMesh::vector_cast<OpenMesh::Vec3d>(mesh.point(*vIt)));
+		}
+		double avgLen = 0.0;
+		for (auto e_h : mesh.edges())
+		{
+			avgLen += mesh.calc_edge_length(e_h);
+		}
+		avgLen /= mesh.n_edges();
+		mesh_avg_length = avgLen;
+		edge_offset = 0.01 * avgLen;
+	}
+
+	void updateMesh()
+	{
+		mesh.update_face_normals();
+		mesh.update_vertex_normals();
+		updateMeshCenter();
+	}
+
+	// MeshViewerWidget::initMesh + InteractiveViewerWidget::initMesh
+	void initMesh()
+	{
+		mesh.request_vertex_status();
+		mesh.request_edge_status();
+		mesh.request_face_status();
+
+		mesh.request_face_normals();
+		mesh.request_vertex_normals();
+
+		init_properties();
+		updateMesh();
+
+		selectedVertex = new_boundary_vertices;
+	}
+
+	// MeshViewerWidget::openMesh
+	bool openMesh(const char* filename)
+	{
+		clearAllMesh();
+		bool read_OK = Mesh_doubleIO::load_mesh(mesh, filename, true);
+		if (read_OK)
+		{
+			initMesh();
+			mesh_vector.push_back(mesh);
+			mesh_vector_index = 0;
+			str_pathname = dir_of(filename);
+			str_filename = filename;
+			str_filepath = absolute_of(filename);
+			return true;
+		}
+		return false;
+	}
+
+	// InteractiveViewerWidget::load_parameterization
+	void load_parameterization(bool silence = false)
+	{
+		if (para_cutting == nullptr)
+		{
+			para_cutting = std::make_unique<ParaQuadCutting>(mesh, str_pathname.c_str(), str_filepath.c_str());
+			M_PE = para_cutting->calc_distortion(silence);
+
+			selectedFace.clear();
+			std::set<int> selected_v;
+			for (int f : para_cutting->get_flipped_faces())
+			{
+				selectedFace.push_back(f);
+
+				for (auto fv_h : mesh.fv_range(mesh.face_handle(f))) selected_v.insert(fv_h.idx());
+			}
+
+			selectedVertex = std::vector<int>(selected_v.begin(), selected_v.end());
+		}
+		else
+		{
+			para_cutting->toggle_viewer_window();
+		}
+	}
+
+	// InteractiveViewerWidget::mirror_neg_charts
+	void mirror_neg_charts()
+	{
+		if (para_cutting == nullptr) return;
+
+		para_cutting->flip_neg_charts();
+		para_cutting->get_textured_mesh(mesh);
+		init_properties();
+
+		para_cutting.reset(nullptr);
+		poly_info.reset(nullptr);
+		initMesh();
+
+		load_parameterization(true);
+	}
+
+	// InteractiveViewerWidget::select_cut_bridges
+	void select_cut_bridges()
+	{
+		if (para_cutting == nullptr) return;
+
+		selectedEdge.clear();
+		std::vector<bool> v_oncut(mesh.n_vertices(), false);
+
+		for (auto e_h : mesh.edges())
+		{
+			if (mesh.property(e_oncut, e_h))
+			{
+				v_oncut[mesh.to_vertex_handle(mesh.halfedge_handle(e_h, 0)).idx()] = true;
+				v_oncut[mesh.to_vertex_handle(mesh.halfedge_handle(e_h, 1)).idx()] = true;
+			}
+		}
+
+		for (auto e_h : mesh.edges())
+		{
+			if (!mesh.property(e_oncut, e_h))
+			{
+				if (v_oncut[mesh.to_vertex_handle(mesh.halfedge_handle(e_h, 0)).idx()] && v_oncut[mesh.to_vertex_handle(mesh.halfedge_handle(e_h, 1)).idx()])
+				{
+					selectedEdge.push_back(e_h.idx());
+				}
+			}
+		}
+	}
+
+	// InteractiveViewerWidget::spilt_seleted_edges
+	void spilt_seleted_edges()
+	{
+		if (para_cutting == nullptr) return;
+
+		if (selectedEdge.empty()) return;
+
+		para_cutting->split_edges(selectedEdge);
+		para_cutting->get_textured_mesh(mesh);
+		selectedEdge.clear();
+		init_properties();
+
+		para_cutting.reset(nullptr);
+		poly_info.reset(nullptr);
+		initMesh();
+
+		load_parameterization(true);
+	}
+
+	// InteractiveViewerWidget::pre_process
+	void pre_process()
+	{
+		mirror_neg_charts();
+		select_cut_bridges();
+		spilt_seleted_edges();
+	}
+
+	// InteractiveViewerWidget::saveNewMesh
+	bool saveNewMesh(const char* filename)
+	{
+		return Mesh_doubleIO::save_mesh(para_cutting->viewer->mesh, filename, false);
+	}
+
+	void make_titles(int n_phase)
+	{
+		para_viewer_titles.clear();
+		para_viewer_titles.reserve(n_phase);
+		para_viewer_titles.emplace_back("Initialization");
+		para_viewer_titles.emplace_back("Rotation");
+		for (int i = 0; i < (n_phase - 5) / 2; i++)
+		{
+			para_viewer_titles.emplace_back("Align Deformation " + std::to_string(i + 1));
+			para_viewer_titles.emplace_back("Inner Deformation " + std::to_string(i + 1));
+		}
+		para_viewer_titles.emplace_back("Flattening");
+		para_viewer_titles.emplace_back("Untangle");
+		para_viewer_titles.emplace_back("Final");
+	}
+
+	// InteractiveViewerWidget::polysquareWithHole
+	void polysquareWithHole()
+	{
+		if (para_cutting == nullptr || poly_info != nullptr) return;
+
+		double goal_length = (para_cutting->get_BB_Max() - para_cutting->get_BB_Min()).norm() / 3000.0;
+
+		std::cout << "--------------------------------------------------\nGoal " << goal_length << std::endl;
+		current_phase = 0;
+		poly_info = std::make_unique<PolySquareDeformation>(mesh, para_cutting->get_origin_para(), para_cutting->viewer->boundary_vk);
+		poly_info->set_path(str_pathname.c_str());
+		if (!poly_info->calcWithHole(kernel_width, goal_length, energy_exp_factor, my_file_name))
+		{
+			poly_info.reset(nullptr);
+			return;
+		}
+
+		int n_phase = poly_info->get_n_phase();
+		make_titles(n_phase);
+		change_phase(n_phase - 1);
+	}
+
+	// InteractiveViewerWidget::polysquare
+	void polysquare()
+	{
+		if (para_cutting == nullptr || poly_info != nullptr) return;
+
+		double goal_length = (para_cutting->get_BB_Max() - para_cutting->get_BB_Min()).norm() / 3000.0;
+
+		std::cout << "--------------------------------------------------\nGoal " << goal_length << std::endl;
+		current_phase = 0;
+		poly_info = std::make_unique<PolySquareDeformation>(mesh, para_cutting->get_origin_para(), para_cutting->viewer->boundary_vk);
+		poly_info->set_path(str_pathname.c_str());
+		if (!poly_info->calc(kernel_width, goal_length, energy_exp_factor, my_file_name))
+		{
+			poly_info.reset(nullptr);
+			return;
+		}
+
+		int n_phase = poly_info->get_n_phase();
+		make_titles(n_phase);
+		change_phase(n_phase - 1);
+	}
+
+	// InteractiveViewerWidget::change_phase
+	void change_phase(int phase)
+	{
+		if (poly_info == nullptr) return;
+
+		int n_phases = para_viewer_titles.size();
+		int new_phase = (phase + n_phases) % n_phases;
+
+		para_cutting->set_viewer_title(QString(para_viewer_titles[new_phase]));
+		poly_info->set_phase(new_phase);
+
+		int scale_id = n_phases - 4;
+		double factor = 1.0;
+		if (current_phase <= scale_id && new_phase > scale_id) factor = 1.0 / poly_info->get_goal_length();
+		if (current_phase > scale_id && new_phase <= scale_id) factor = poly_info->get_goal_length();
+		para_cutting->update_para(factor);
+		para_cutting->update_textured_mesh(mesh);
+
+		current_phase = new_phase;
+	}
+
+	bool straightening_succeeded() const { return poly_info != nullptr; }
+};
+
+// Code/Straighten/Straighten/main.cpp (without QApplication)
+int main(int argc, char* argv[])
+{
+	if (argc < 4)
+	{
+		std::cerr << "usage: z21_straighten <input.obj with vt> <before.obj> <after.obj>" << std::endl;
+		return 2;
+	}
+	clock_t startTime = std::clock();
+	HeadlessStraightenViewer v;
+	if (!v.openMesh(argv[1]))
+	{
+		std::cout << "Can't Open Mesh! " << std::endl;
+		return 3;
+	}
+	v.load_parameterization();
+	v.input_distortion = v.para_cutting->get_distortion();
+
+	std::vector<std::vector<int>> boundarys;
+	AssistFunc::FindBoundarys(v.mesh, boundarys);
+	if (boundarys.size() == 1)
+	{
+		v.pre_process();
+		v.saveNewMesh(argv[2]);
+		v.polysquare();
+		v.saveNewMesh(argv[3]);
+	}
+	else
+	{
+		v.pre_process();
+		v.saveNewMesh(argv[2]);
+		v.polysquareWithHole();
+		v.saveNewMesh(argv[3]);
+	}
+	clock_t endTime = std::clock();
+	std::cout << "[z21_straighten] boundary_loops=" << boundarys.size()
+		<< " straightening_succeeded=" << (v.straightening_succeeded() ? 1 : 0)
+		<< " cpu_seconds=" << (endTime - startTime) / double(CLOCKS_PER_SEC) << std::endl;
+	// The authors' program writes the after-mesh even when calc() fails
+	// (it then equals the pre-processed input).  Report this explicitly.
+	return v.straightening_succeeded() ? 0 : 4;
+}
diff --git a/onestring_port/straighten/shim/Eigen/CholmodSupport b/onestring_port/straighten/shim/Eigen/CholmodSupport
new file mode 100644
