+++ b/onestring_port/straighten/shim/z21_qt_headless.h
@@ -0,0 +1,56 @@
+// OneString portability: the minimum of the Qt API that the authors'
+// Straighten *core* classes touch (timing, a title string, std::string
+// conversion).  The original program links Qt 5 only for its GUI; the
+// batch pipeline (Straighten.exe in WholePipeline.bat) never shows a window.
+#pragma once
+#include <chrono>
+#include <string>
+
+class QByteArray
+{
+public:
+	QByteArray() {}
+	explicit QByteArray(const std::string& s) : s_(s) {}
+	operator const char*() const { return s_.c_str(); }
+	const char* data() const { return s_.c_str(); }
+	const char* constData() const { return s_.c_str(); }
+private:
+	std::string s_;
+};
+
+class QString
+{
+public:
+	QString() {}
+	QString(const char* s) : s_(s ? s : "") {}
+	QString(const std::string& s) : s_(s) {}
+	static QString fromStdString(const std::string& s) { return QString(s); }
+	static QString number(double v) { return QString(std::to_string(v)); }
+	static QString number(int v) { return QString(std::to_string(v)); }
+	static QString number(long v) { return QString(std::to_string(v)); }
+	std::string toStdString() const { return s_; }
+	QByteArray toLocal8Bit() const { return QByteArray(s_); }
+	QByteArray toLatin1() const { return QByteArray(s_); }
+	QString operator+(const QString& o) const { return QString(s_ + o.s_); }
+	QString& operator+=(const QString& o) { s_ += o.s_; return *this; }
+	bool operator<(const QString& o) const { return s_ < o.s_; }
+	bool operator==(const QString& o) const { return s_ == o.s_; }
+	bool isEmpty() const { return s_.empty(); }
+private:
+	std::string s_;
+};
+inline QString operator+(const char* a, const QString& b) { return QString(a) + b; }
+
+class QTime
+{
+public:
+	void start() { t0_ = std::chrono::steady_clock::now(); }
+	int restart() { int e = elapsed(); start(); return e; }
+	int elapsed() const
+	{
+		return (int)std::chrono::duration_cast<std::chrono::milliseconds>(
+			std::chrono::steady_clock::now() - t0_).count();
+	}
+private:
+	std::chrono::steady_clock::time_point t0_ = std::chrono::steady_clock::now();
+};
