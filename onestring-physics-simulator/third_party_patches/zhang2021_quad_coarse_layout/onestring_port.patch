diff --git a/onestring_port/src/PardisoSolverEigen.cpp b/onestring_port/src/PardisoSolverEigen.cpp
new file mode 100644
index 0000000..a2a30cf
--- /dev/null
+++ b/onestring_port/src/PardisoSolverEigen.cpp
@@ -0,0 +1,144 @@
+// OneString portability replacement for the authors' PardisoSolver.cpp.
+//
+// The reference implementation of Zhang et al. (CAD 2021) links the licensed
+// PARDISO 6.0 library (pardiso-project.org) with mtype = -2 (real symmetric
+// indefinite, upper-triangular CSR input).  That library and its per-user
+// license are not available on macOS/Linux, so this file implements the SAME
+// class interface (PardisoSolver.h is unchanged) with an Eigen sparse direct
+// solver.  A direct factorisation returns the same solution of the same
+// linear system up to floating point round-off; no algorithmic parameter of
+// the paper's pipeline is changed here.
+//
+// Semantics reproduced from the original PardisoSolver.cpp:
+//   * pardiso_init(): mtype=-2, result.resize(num), ia/ja converted to
+//     1-based indices (the original passes Fortran-style indices to PARDISO),
+//     symbolic analysis.
+//   * factorize(): numerical factorisation, returns success flag.
+//   * pardiso_solver(): solve with `rhs`, at most one step of iterative
+//     refinement (original sets iparm[7] = 1).
+//   * free_numerical_factorization_memory(): release the factorisation.
+//
+// The symmetric matrix is given as its upper triangle.  Because the systems
+// assembled by the authors are saddle-point (KKT) systems with a zero block,
+// we use a pivoting LU factorisation (Eigen::SparseLU) of the full symmetric
+// matrix instead of an unpivoted LDLT, which would be unstable on a zero
+// diagonal block.  PARDISO uses Bunch-Kaufman pivoting for the same reason.
+
+#include "PardisoSolver.h"
+
+#include <Eigen/Sparse>
+#include <Eigen/SparseLU>
+#include <Eigen/OrderingMethods>
+
+#include <stdexcept>
+#include <vector>
+
+namespace {
+
+struct EigenPardisoState
+{
+	Eigen::SparseMatrix<double> A;
+	Eigen::SparseLU<Eigen::SparseMatrix<double>, Eigen::COLAMDOrdering<int>> lu;
+	bool analyzed = false;
+	bool factorized = false;
+};
+
+EigenPardisoState* state_of(void* const* pt)
+{
+	return static_cast<EigenPardisoState*>(pt[0]);
+}
+
+// Build the full symmetric matrix from the (1-based) upper-triangular CSR.
+void assemble_full(const std::vector<int>& ia, const std::vector<int>& ja,
+	const std::vector<double>& a, int n, Eigen::SparseMatrix<double>& A)
+{
+	std::vector<Eigen::Triplet<double>> trip;
+	trip.reserve(a.size() * 2);
+	for (int row = 0; row < n; ++row)
+	{
+		for (int k = ia[row] - 1; k < ia[row + 1] - 1; ++k)
+		{
+			int col = ja[k] - 1;
+			double v = a[k];
+			trip.emplace_back(row, col, v);
+			if (col != row) trip.emplace_back(col, row, v);
+		}
+	}
+	A.resize(n, n);
+	A.setFromTriplets(trip.begin(), trip.end());
+	A.makeCompressed();
+}
+
+} // namespace
+
+PardisoSolver::PardisoSolver()
+{
+	// The original constructor leaves mtype uninitialised and the destructor
+	// branches on it; initialise to the documented "not set" value instead.
+	mtype = -1;
+	for (int t = 0; t < 64; ++t) pt[t] = nullptr;
+}
+
+PardisoSolver::~PardisoSolver()
+{
+	delete state_of(pt);
+	pt[0] = nullptr;
+}
+
+void PardisoSolver::pardiso_init()
+{
+	mtype = -2;
+	result.clear();
+	result.resize(num, 0);
+	nrhs = 1;
+	error = 0;
+
+	for (i = 0; i < num + 1; i++) ia[i] += 1;
+	for (i = 0; i < nnz; i++) ja[i] += 1;
+
+	delete state_of(pt);
+	EigenPardisoState* s = new EigenPardisoState();
+	pt[0] = s;
+	assemble_full(ia, ja, a, num, s->A);
+	s->lu.analyzePattern(s->A);
+	s->analyzed = true;
+}
+
+bool PardisoSolver::factorize()
+{
+	if (mtype == -1)
+		throw std::runtime_error("Pardiso mtype not set.");
+	EigenPardisoState* s = state_of(pt);
+	if (s == nullptr) throw std::runtime_error("PardisoSolverEigen: factorize before init");
+	// `a` may have been updated by the caller since pardiso_init().
+	assemble_full(ia, ja, a, num, s->A);
+	if (!s->analyzed) { s->lu.analyzePattern(s->A); s->analyzed = true; }
+	s->lu.factorize(s->A);
+	s->factorized = (s->lu.info() == Eigen::Success);
+	error = s->factorized ? 0 : -4;
+	return s->factorized;
+}
+
+void PardisoSolver::pardiso_solver()
+{
+	EigenPardisoState* s = state_of(pt);
+	if (s == nullptr || !s->factorized)
+	{
+		// PARDISO would return an error code; keep the previous result.
+		error = -4;
+		return;
+	}
+	Eigen::Map<const Eigen::VectorXd> b(rhs.data(), num);
+	Eigen::VectorXd x = s->lu.solve(b);
+	// One step of iterative refinement (original: iparm[7] = 1).
+	Eigen::VectorXd r = b - s->A * x;
+	x += s->lu.solve(r);
+	result.assign(x.data(), x.data() + num);
+	error = 0;
+}
+
+void PardisoSolver::free_numerical_factorization_memory()
+{
+	EigenPardisoState* s = state_of(pt);
+	if (s != nullptr) s->factorized = false;
+}
