+//
+//  NeckEnergy.hpp
+//  OptCuts (OneString fork, 2026-11-17)
+//
+//  Penalty on the shape of the UV chart outline:
+//   * narrow necks: a barrier between two outline points that face each other across the chart (the segment between
+//     them runs inside the chart) and are far apart along the outline, active when their distance is below d0.
+//     It goes to infinity as the width goes to zero, so a neck can never close (the chart never breaks apart).
+//   * roundness: P^2 / (4 pi A) - 1 of the UV chart (P = outline length, A = chart area); 0 for a disk.
+//  env: ONESTRING_NECK_W (weight of the neck barrier, default 0 = off), ONESTRING_NECK_D0 (d0 as a fraction of the
+//       virtual radius sqrt(surface area / pi), default 0.25), ONESTRING_ROUND_W (weight of the roundness term, default 0)
+//
+
+#ifndef NeckEnergy_hpp
+#define NeckEnergy_hpp
+
+#include "Energy.hpp"
+#include <vector>
+
+namespace OptCuts {
+
+    class NeckEnergy : public Energy {
+    public:
+        NeckEnergy(double p_wNeck, double p_d0Rel, double p_wRound);
+
+        static bool enabledFromEnv(double& wNeck, double& d0Rel, double& wRound);
+
+        virtual void computeEnergyVal(const TriMesh& data, double& energyVal, bool uniformWeight = false) const;
+        virtual void getEnergyValPerElem(const TriMesh& data, Eigen::VectorXd& energyValPerElem, bool uniformWeight = false) const;
+        virtual void getEnergyValByElemID(const TriMesh& data, int elemI, double& energyVal, bool uniformWeight = false) const;
+        virtual void computeGradient(const TriMesh& data, Eigen::VectorXd& gradient, bool uniformWeight = false) const;
+        virtual void computeHessian(const TriMesh& data, Eigen::VectorXd* V,
+                                    Eigen::VectorXi* I = NULL, Eigen::VectorXi* J = NULL, bool uniformWeight = false) const;
+        virtual void computeHessian(const TriMesh& data, Eigen::MatrixXd& Hessian, bool uniformWeight = false) const;
+        virtual void checkEnergyVal(const TriMesh& data) const;
+        virtual void initStepSize(const TriMesh& data, const Eigen::VectorXd& searchDir, double& stepSize) const;
+
+        // diagnostics of the last evaluation
+        struct Stats { double neck = 0.0, round = 0.0, minWidthRel = 1e30; int pairs = 0; };
+        Stats stats(const TriMesh& data) const;
+
+    private:
+        double wNeck, d0Rel, wRound;
+
+        struct Outline {
+            std::vector<int> v;          // outline vertices (all loops)
+            std::vector<int> prev, next; // indices into v
+            std::vector<int> loop;       // loop id per entry
+            std::vector<double> arc;     // rest arclength from the loop start
+            std::vector<double> loopLen;
+            std::vector<double> dual;    // rest dual length (half of the two incident outline edges)
+            double orient = 1.0;         // +1 if the chart lies to the left of the outline direction
+        };
+        struct Pair { int a, b; double d, x, w; Eigen::Vector2d n; };
+
+        // the set of facing pairs (and their weights) is frozen between refreshes so that energy and gradient are exact
+        // within one Newton step; it is refreshed when the gradient is computed (once per step) or the topology changed
+        struct Cache { const TriMesh* ptr = NULL; long nV = -1, nF = -1; Outline O; std::vector<Pair> P; };
+        mutable Cache cache;
+        const Cache& frozen(const TriMesh& data, bool refresh) const;
+
+        void outline(const TriMesh& data, Outline& O) const;
+        void pairs(const TriMesh& data, const Outline& O, double d0, std::vector<Pair>& P, double searchR) const;
+        double d0Abs(const TriMesh& data) const { return d0Rel * data.virtualRadius; }
+        void roundness(const TriMesh& data, const Outline& O, double& E, Eigen::VectorXd* grad) const;
+    };
+
+}
+
+#endif /* NeckEnergy_hpp */
