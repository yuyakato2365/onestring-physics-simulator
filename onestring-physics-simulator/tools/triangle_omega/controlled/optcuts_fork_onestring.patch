+//
+//  NeckEnergy.cpp
+//  OptCuts (OneString fork, 2026-11-17)
+//
+
+#include "NeckEnergy.hpp"
+#include <cmath>
+#include <cstdlib>
+#include <map>
+#include <unordered_map>
+#include <iostream>
+
+namespace OptCuts {
+
+    static inline double smoothstep(double t) { t = std::min(1.0, std::max(0.0, t)); return t * t * (3.0 - 2.0 * t); }
+    // barrier b(x) = -(x - 1)^2 ln x for 0 < x < 1, 0 for x >= 1 (C2 at x = 1)
+    static inline double bar(double x) { return (x >= 1.0) ? 0.0 : -(x - 1.0) * (x - 1.0) * std::log(x); }
+    static inline double bar1(double x) { return (x >= 1.0) ? 0.0 : -2.0 * (x - 1.0) * std::log(x) - (x - 1.0) * (x - 1.0) / x; }
+    static inline double bar2(double x) {
+        return (x >= 1.0) ? 0.0 : -2.0 * std::log(x) - 4.0 * (x - 1.0) / x + (x - 1.0) * (x - 1.0) / (x * x);
+    }
+
+    NeckEnergy::NeckEnergy(double p_wNeck, double p_d0Rel, double p_wRound) :
+        Energy(true), wNeck(p_wNeck), d0Rel(p_d0Rel), wRound(p_wRound) {}
+
+    bool NeckEnergy::enabledFromEnv(double& wNeck, double& d0Rel, double& wRound)
+    {
+        wNeck = 0.0; d0Rel = 0.25; wRound = 0.0;
+        if(const char* e = std::getenv("ONESTRING_NECK_W")) { wNeck = std::atof(e); }
+        if(const char* e = std::getenv("ONESTRING_NECK_D0")) { d0Rel = std::atof(e); }
+        if(const char* e = std::getenv("ONESTRING_ROUND_W")) { wRound = std::atof(e); }
+        return (wNeck > 0.0) || (wRound > 0.0);
+    }
+
+    void NeckEnergy::outline(const TriMesh& data, Outline& O) const
+    {
+        // boundary half-edges: (a -> b) present, (b -> a) absent
+        std::map<std::pair<int, int>, int> he;
+        for(int f = 0; f < data.F.rows(); f++) {
+            for(int k = 0; k < 3; k++) { he[{data.F(f, k), data.F(f, (k + 1) % 3)}] = 1; }
+        }
+        std::unordered_map<int, int> nxt;
+        for(const auto& h : he) {
+            if(he.find({h.first.second, h.first.first}) == he.end()) { nxt[h.first.first] = h.first.second; }
+        }
+        std::unordered_map<int, int> idx;
+        O.v.clear(); O.prev.clear(); O.next.clear(); O.loop.clear(); O.arc.clear(); O.loopLen.clear(); O.dual.clear();
+        for(const auto& s : nxt) {
+            if(idx.count(s.first)) { continue; }
+            int start = (int)O.v.size(), lid = (int)O.loopLen.size(), x = s.first; double c = 0.0;
+            do {
+                idx[x] = (int)O.v.size(); O.v.push_back(x); O.loop.push_back(lid); O.arc.push_back(c);
+                int y = nxt[x]; c += (data.V_rest.row(y) - data.V_rest.row(x)).norm(); x = y;
+            } while(x != s.first && !idx.count(x));
+            int n = (int)O.v.size() - start;
+            O.loopLen.push_back(c);
+            for(int i = 0; i < n; i++) {
+                O.prev.push_back(start + (i + n - 1) % n); O.next.push_back(start + (i + 1) % n);
+            }
+        }
+        O.dual.resize(O.v.size());
+        for(size_t i = 0; i < O.v.size(); i++) {
+            const int a = O.v[O.prev[i]], b = O.v[i], c = O.v[O.next[i]];
+            O.dual[i] = 0.5 * ((data.V_rest.row(b) - data.V_rest.row(a)).norm() + (data.V_rest.row(c) - data.V_rest.row(b)).norm());
+        }
+        // orientation: the chart lies to the left of a boundary half-edge iff the faces are counter-clockwise in UV
+        double A = 0.0;
+        for(int f = 0; f < data.F.rows(); f++) {
+            const Eigen::RowVector2d p = data.V.row(data.F(f, 0)), q = data.V.row(data.F(f, 1)), r = data.V.row(data.F(f, 2));
+            A += 0.5 * ((q - p)[0] * (r - p)[1] - (q - p)[1] * (r - p)[0]);
+        }
+        O.orient = (A >= 0.0) ? 1.0 : -1.0;
+    }
+
+    void NeckEnergy::pairs(const TriMesh& data, const Outline& O, double d0, std::vector<Pair>& P, double searchR) const
+    {
+        P.clear();
+        const int n = (int)O.v.size();
+        if(n == 0) { return; }
+        std::vector<Eigen::Vector2d> u(n), nin(n);
+        for(int i = 0; i < n; i++) { u[i] = data.V.row(O.v[i]).transpose(); }
+        for(int i = 0; i < n; i++) {
+            const Eigen::Vector2d t = u[O.next[i]] - u[O.prev[i]];
+            Eigen::Vector2d m(-t[1], t[0]); m *= O.orient;   // left of the outline direction = inside
+            const double l = m.norm(); nin[i] = (l > 0.0) ? Eigen::Vector2d(m / l) : Eigen::Vector2d(0.0, 0.0);
+        }
+        // uniform grid with cell size searchR
+        std::unordered_map<long long, std::vector<int>> grid;
+        auto key = [&](int gx, int gy) { return ((long long)gx << 32) ^ (long long)(unsigned int)gy; };
+        for(int i = 0; i < n; i++) {
+            grid[key((int)std::floor(u[i][0] / searchR), (int)std::floor(u[i][1] / searchR))].push_back(i);
+        }
+        for(int i = 0; i < n; i++) {
+            const int gx = (int)std::floor(u[i][0] / searchR), gy = (int)std::floor(u[i][1] / searchR);
+            for(int dx = -1; dx <= 1; dx++) for(int dy = -1; dy <= 1; dy++) {
+                auto it = grid.find(key(gx + dx, gy + dy));
+                if(it == grid.end()) { continue; }
+                for(int j : it->second) {
+                    if(j <= i) { continue; }
+                    if(O.v[i] == O.v[j]) { continue; }
+                    // same 3D point (two copies of a seam vertex) never form a neck
+                    if((data.V_rest.row(O.v[i]) - data.V_rest.row(O.v[j])).squaredNorm() < 1e-24) { continue; }
+                    const Eigen::Vector2d e = u[j] - u[i]; const double d = e.norm();
+                    if(d >= searchR || d <= 0.0) { continue; }
+                    // far apart along the outline (pairs on the same smooth stretch of the outline are not a neck)
+                    double warc = 1.0;
+                    if(O.loop[i] == O.loop[j]) {
+                        double s = std::abs(O.arc[i] - O.arc[j]); s = std::min(s, O.loopLen[O.loop[i]] - s);
+                        warc = smoothstep((s - 2.0 * d0) / d0);
+                    }
+                    if(warc <= 0.0) { continue; }
+                    // facing each other across the chart: the segment leaves both points towards the inside
+                    const Eigen::Vector2d nn = e / d;
+                    const double c = std::min(nn.dot(nin[i]), -nn.dot(nin[j]));
+                    const double wdir = smoothstep((c - 0.2) / 0.4);
+                    if(wdir <= 0.0) { continue; }
+                    Pair p; p.a = i; p.b = j; p.d = d; p.x = d / d0; p.w = warc * wdir * O.dual[i] * O.dual[j]; p.n = nn;
+                    P.push_back(p);
+                }
+            }
+        }
+    }
+
+    void NeckEnergy::roundness(const TriMesh& data, const Outline& O, double& E, Eigen::VectorXd* grad) const
+    {
+        double Per = 0.0, A = 0.0;
+        for(size_t i = 0; i < O.v.size(); i++) { Per += (data.V.row(O.v[O.next[i]]) - data.V.row(O.v[i])).norm(); }
+        for(int f = 0; f < data.F.rows(); f++) {
+            const Eigen::RowVector2d p = data.V.row(data.F(f, 0)), q = data.V.row(data.F(f, 1)), r = data.V.row(data.F(f, 2));
+            A += 0.5 * ((q - p)[0] * (r - p)[1] - (q - p)[1] * (r - p)[0]);
+        }
+        A = std::abs(A);
+        E = Per * Per / (4.0 * M_PI * A) - 1.0;
+        if(!grad) { return; }
+        const double cP = 2.0 * Per / (4.0 * M_PI * A), cA = -Per * Per / (4.0 * M_PI * A * A);
+        for(size_t i = 0; i < O.v.size(); i++) {
+            const int a = O.v[i], b = O.v[O.next[i]];
+            Eigen::Vector2d e = (data.V.row(b) - data.V.row(a)).transpose(); const double l = e.norm();
+            if(l <= 0.0) { continue; }
+            e /= l;
+            grad->segment<2>(2 * b) += cP * e; grad->segment<2>(2 * a) -= cP * e;
+        }
+        const double s = 0.5 * O.orient;
+        for(int f = 0; f < data.F.rows(); f++) {
+            for(int k = 0; k < 3; k++) {
+                const int vi = data.F(f, k), vj = data.F(f, (k + 1) % 3), vk = data.F(f, (k + 2) % 3);
+                const Eigen::Vector2d opp = (data.V.row(vk) - data.V.row(vj)).transpose();
+                // d(area)/d(u_i) = 0.5 * perp(u_k - u_j) for a counter-clockwise triangle
+                grad->segment<2>(2 * vi) += cA * s * Eigen::Vector2d(opp[1], -opp[0]);
+            }
+        }
+    }
+
+    const NeckEnergy::Cache& NeckEnergy::frozen(const TriMesh& data, bool refresh) const
+    {
+        if(refresh || cache.ptr != &data || cache.nV != data.V.rows() || cache.nF != data.F.rows()) {
+            cache.ptr = &data; cache.nV = data.V.rows(); cache.nF = data.F.rows();
+            outline(data, cache.O);
+            pairs(data, cache.O, d0Abs(data), cache.P, 2.0 * d0Abs(data));
+        }
+        return cache;
+    }
+
+    // current distance / direction of a frozen pair
+    static inline void current(const TriMesh& data, int va, int vb, double& d, Eigen::Vector2d& n)
+    {
+        const Eigen::Vector2d e = (data.V.row(vb) - data.V.row(va)).transpose(); d = e.norm(); n = (d > 0.0) ? Eigen::Vector2d(e / d) : Eigen::Vector2d(1.0, 0.0);
+    }
+
+    void NeckEnergy::computeEnergyVal(const TriMesh& data, double& energyVal, bool) const
+    {
+        const Cache& C = frozen(data, false);
+        const double d0 = d0Abs(data), norm = M_PI * data.virtualRadius * data.virtualRadius;
+        energyVal = 0.0;
+        if(wNeck > 0.0) {
+            for(const auto& p : C.P) {
+                double d; Eigen::Vector2d n; current(data, C.O.v[p.a], C.O.v[p.b], d, n);
+                if(d <= 0.0) { energyVal = __DBL_MAX__; return; }
+                energyVal += wNeck * p.w * bar(d / d0) / norm;
+            }
+        }
+        if(wRound > 0.0) { double Er; roundness(data, C.O, Er, NULL); energyVal += wRound * Er; }
+    }
+
+    void NeckEnergy::getEnergyValPerElem(const TriMesh& data, Eigen::VectorXd& energyValPerElem, bool) const
+    {
+        energyValPerElem.setZero(data.F.rows());
+    }
+
+    void NeckEnergy::getEnergyValByElemID(const TriMesh& data, int elemI, double& energyVal, bool) const
+    {
+        energyVal = 0.0;
+    }
+
+    void NeckEnergy::computeGradient(const TriMesh& data, Eigen::VectorXd& gradient, bool) const
+    {
+        gradient.setZero(data.V.rows() * 2);
+        const Cache& C = frozen(data, true);
+        const double d0 = d0Abs(data), norm = M_PI * data.virtualRadius * data.virtualRadius;
+        if(wNeck > 0.0) {
+            for(const auto& p : C.P) {
+                double d; Eigen::Vector2d n; current(data, C.O.v[p.a], C.O.v[p.b], d, n);
+                const double g = wNeck * p.w * bar1(d / d0) / (d0 * norm);
+                gradient.segment<2>(2 * C.O.v[p.b]) += g * n;
+                gradient.segment<2>(2 * C.O.v[p.a]) -= g * n;
+            }
+        }
+        if(wRound > 0.0) { Eigen::VectorXd gr = Eigen::VectorXd::Zero(data.V.rows() * 2); double Er; roundness(data, C.O, Er, &gr); gradient += wRound * gr; }
+        for(const auto fixedVI : data.fixedVert) { gradient[2 * fixedVI] = 0.0; gradient[2 * fixedVI + 1] = 0.0; }
+    }
+
+    void NeckEnergy::computeHessian(const TriMesh& data, Eigen::VectorXd* V, Eigen::VectorXi* I, Eigen::VectorXi* J, bool) const
+    {
+        // positive semi-definite part of the barrier Hessian (b'' n n^T per pair); the roundness term has no Hessian here
+        std::vector<double> vv; std::vector<int> ii, jj;
+        if(wNeck > 0.0) {
+            const Cache& C = frozen(data, false);
+            const double d0 = d0Abs(data), norm = M_PI * data.virtualRadius * data.virtualRadius;
+            for(const auto& p : C.P) {
+                double d; Eigen::Vector2d n; current(data, C.O.v[p.a], C.O.v[p.b], d, n);
+                const double k = wNeck * p.w * bar2(d / d0) / (d0 * d0 * norm);
+                if(k <= 0.0) { continue; }
+                const Eigen::Matrix2d K = k * n * n.transpose();
+                const int va = C.O.v[p.a], vb = C.O.v[p.b];
+                const bool fa = data.fixedVert.count(va), fb = data.fixedVert.count(vb);
+                for(int r = 0; r < 2; r++) for(int c = 0; c < 2; c++) {
+                    if(!fa) { ii.push_back(2 * va + r); jj.push_back(2 * va + c); vv.push_back(K(r, c)); }
+                    if(!fb) { ii.push_back(2 * vb + r); jj.push_back(2 * vb + c); vv.push_back(K(r, c)); }
+                    if(!fa && !fb) {
+                        ii.push_back(2 * va + r); jj.push_back(2 * vb + c); vv.push_back(-K(r, c));
+                        ii.push_back(2 * vb + r); jj.push_back(2 * va + c); vv.push_back(-K(r, c));
+                    }
+                }
+            }
+        }
+        V->resize(vv.size()); I->resize(ii.size()); J->resize(jj.size());
+        for(size_t t = 0; t < vv.size(); t++) { (*V)[t] = vv[t]; (*I)[t] = ii[t]; (*J)[t] = jj[t]; }
+    }
+
+    void NeckEnergy::computeHessian(const TriMesh& data, Eigen::MatrixXd& Hessian, bool uniformWeight) const
+    {
+        Eigen::VectorXd V; Eigen::VectorXi I, J; computeHessian(data, &V, &I, &J, uniformWeight);
+        Hessian.setZero(data.V.rows() * 2, data.V.rows() * 2);
+        for(int t = 0; t < V.size(); t++) { Hessian(I[t], J[t]) += V[t]; }
+    }
+
+    void NeckEnergy::checkEnergyVal(const TriMesh& data) const {}
+
+    void NeckEnergy::initStepSize(const TriMesh& data, const Eigen::VectorXd& searchDir, double& stepSize) const
+    {
+        // a step may not shrink the distance of any facing outline pair within 2 d0 below 20 % of its current value
+        if(wNeck <= 0.0) { return; }
+        const Cache& C = frozen(data, false);
+        for(const auto& p : C.P) {
+            double d; Eigen::Vector2d n; current(data, C.O.v[p.a], C.O.v[p.b], d, n);
+            const Eigen::Vector2d ds = searchDir.segment<2>(2 * C.O.v[p.b]) - searchDir.segment<2>(2 * C.O.v[p.a]);
+            const double approach = -ds.dot(n);                     // rate at which the pair closes
+            if(approach > 0.0) { stepSize = std::min(stepSize, 0.8 * d / approach); }
+        }
+    }
+
+    NeckEnergy::Stats NeckEnergy::stats(const TriMesh& data) const
+    {
+        Stats s; Outline O; outline(data, O);
+        const double d0 = d0Abs(data), norm = M_PI * data.virtualRadius * data.virtualRadius;
+        std::vector<Pair> P; pairs(data, O, d0, P, 2.0 * d0);
+        for(const auto& p : P) {
+            s.minWidthRel = std::min(s.minWidthRel, p.d / data.virtualRadius);
+            if(p.x < 1.0) { s.neck += p.w * bar(p.x) / norm; s.pairs++; }
+        }
+        roundness(data, O, s.round, NULL);
+        return s;
+    }
+
+}
