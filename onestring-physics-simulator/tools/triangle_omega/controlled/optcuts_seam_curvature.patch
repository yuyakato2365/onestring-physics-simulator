+#pragma once
+#include <Eigen/Geometry>
+#include <array>
+#include <cmath>
+#include <cstdlib>
+#include <fstream>
+#include <iomanip>
+#include <map>
+#include <set>
+#include <stdexcept>
+#include <vector>
+
+// The rest surface is shared by the cut chart and every split/merge trial.
+// Evaluate curvature before UV duplication so the two banks see the same field.
+namespace SeamCurvature {
+using Key = std::array<double, 3>;
+struct Field {
+    double strength = 0.0;
+    std::map<Key, double> value;
+};
+inline Field& field() { static Field f; return f; }
+inline Key key(const Eigen::RowVector3d& p) { return {{p[0], p[1], p[2]}}; }
+
+inline void prepare(const Eigen::MatrixXd& v, const Eigen::MatrixXi& faces) {
+    const char* weight = std::getenv("ONESTRING_SEAM_CURVATURE_W");
+    const double w = weight ? std::atof(weight) : 0.;
+    const char* report = std::getenv("ONESTRING_SEAM_CURVATURE_DUMP");
+    if (w == 0. && !report) return;
+    const int n = v.rows();
+    std::vector<std::set<int>> neighbors(n);
+    Eigen::MatrixXd normals = Eigen::MatrixXd::Zero(n, 3);
+    double twiceArea = 0.;
+    for (int f = 0; f < faces.rows(); ++f) {
+        const Eigen::Vector3i ids = faces.row(f);
+        const Eigen::RowVector3d a = v.row(ids[1]) - v.row(ids[0]), b = v.row(ids[2]) - v.row(ids[0]);
+        const Eigen::RowVector3d normal = a.cross(b);
+        twiceArea += normal.norm();
+        for (int i = 0; i < 3; ++i) {
+            normals.row(ids[i]) += normal;
+            neighbors[ids[i]].insert(ids[(i+1)%3]);
+            neighbors[ids[(i+1)%3]].insert(ids[i]);
+        }
+    }
+    for (int i = 0; i < n; ++i) normals.row(i).normalize();
+    const double radius = std::sqrt(twiceArea / (2. * std::acos(-1.)));
+    Eigen::VectorXd raw(n), smooth(n);
+    for (int i = 0; i < n; ++i) {
+        double normalVariation = 0., squaredLength = 0.;
+        for (int j : neighbors[i]) {
+            normalVariation += (normals.row(i) - normals.row(j)).squaredNorm();
+            squaredLength += (v.row(i) - v.row(j)).squaredNorm();
+        }
+        raw[i] = squaredLength > 0. ? std::sqrt(normalVariation / squaredLength) : 0.;
+    }
+    // A local average limits one-ring sampling noise at irregular vertices.
+    for (int i = 0; i < n; ++i) {
+        double sum = 0.;
+        for (int j : neighbors[i]) sum += raw[j];
+        const double mean = neighbors[i].empty() ? raw[i] : sum / neighbors[i].size();
+        smooth[i] = std::log1p(radius * .5 * (raw[i] + mean));
+    }
+    field().strength = .1 * w * radius;
+    std::ofstream output;
+    if (report) {
+        output.open(report);
+        if (!output) throw std::runtime_error("Cannot write seam curvature field");
+        output << std::setprecision(17);
+    }
+    for (int i = 0; i < n; ++i) {
+        field().value[key(v.row(i))] = smooth[i];
+        if (report) output << smooth[i] << '\n';
+    }
+}
+inline double cost(const Eigen::RowVector3d& a, const Eigen::RowVector3d& b) {
+    const Field& f = field();
+    if (f.strength == 0.) return 0.;
+    return f.strength * std::abs(f.value.at(key(a)) - f.value.at(key(b)));
+}
+}
