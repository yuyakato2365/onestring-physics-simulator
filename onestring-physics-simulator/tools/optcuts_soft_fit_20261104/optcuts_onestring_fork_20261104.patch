+// 2026-11-03 (OneString): optional mirror-symmetry term for the seams (env ONESTRING_SYM_W > 0 together with
+// ONESTRING_SYM_PLANE="nx,ny,nz,d", the mirror plane n.x = d in the input frame; ONESTRING_SYM_TOL optional,
+// default 0.6 x mean edge length).  E_sym = sum of |e| over the seam edges e that are off the plane and whose
+// mirror image is not a seam edge; it is added to the seam length with weight w (same normalisation).  A new seam
+// edge changes E_sym by +|e| (unpaired), 0 (on the plane) or -|e| (it completes the mirror image of an existing
+// seam edge); a merge changes it by the opposite amounts.
+struct OsSym { bool on = false; double w = 0.0, tol = 0.0, d = 0.0; Eigen::RowVector3d n = Eigen::RowVector3d::Zero(); };
+static const OsSym& osSym(const OptCuts::TriMesh& m)
+{
+    static OsSym s;
+    static bool init = false;
+    if(!init) {
+        init = true;
+        const char* ew = std::getenv("ONESTRING_SYM_W");
+        const char* ep = std::getenv("ONESTRING_SYM_PLANE");
+        double a = 0, b = 0, c = 0, dd = 0;
+        if(ew && ep && std::atof(ew) > 0.0 && std::sscanf(ep, "%lf,%lf,%lf,%lf", &a, &b, &c, &dd) == 4) {
+            s.w = std::atof(ew);
+            s.n << a, b, c;
+            const double nn = s.n.norm();
+            if(nn > 1.0e-12) {
+                s.n /= nn; s.d = dd / nn; s.on = true;
+                const char* et = std::getenv("ONESTRING_SYM_TOL");
+                if(et) { s.tol = std::atof(et); }
+                else {
+                    double sum = 0.0; int cnt = 0;
+                    for(int t = 0; t < m.F.rows(); t++) {
+                        for(int k = 0; k < 3; k++) { sum += (m.V_rest.row(m.F(t, k)) - m.V_rest.row(m.F(t, (k + 1) % 3))).norm(); cnt++; }
+                    }
+                    s.tol = 0.6 * sum / std::max(cnt, 1);
+                }
+                std::cout << "[ONESTRING] seam symmetry term: w " << s.w << ", plane (" << s.n << ") . x = " << s.d
+                          << ", tolerance " << s.tol << std::endl;
+            }
+        }
+    }
+    return s;
+}
+// 0: the 3D edge (a, b) lies on the mirror plane; -1: its mirror image is a current seam edge other than (a, b)
+// itself; +1 otherwise
+static int osSymStatus(const OptCuts::TriMesh& m, int a, int b)
+{
+    const OsSym& s = osSym(m);
+    const Eigen::RowVector3d pa = m.V_rest.row(a), pb = m.V_rest.row(b);
+    if(std::abs(pa.dot(s.n) - s.d) < s.tol && std::abs(pb.dot(s.n) - s.d) < s.tol) { return 0; }
+    const Eigen::RowVector3d ra = pa - 2.0 * (pa.dot(s.n) - s.d) * s.n, rb = pb - 2.0 * (pb.dot(s.n) - s.d) * s.n;
+    for(int c = 0; c < m.cohE.rows(); c++) {
+        if(m.boundaryEdge[c]) { continue; }
+        const int x = m.cohE(c, 0), y = m.cohE(c, 1);
+        if((x < 0) || (y < 0)) { continue; }
+        const Eigen::RowVector3d px = m.V_rest.row(x), py = m.V_rest.row(y);
+        if((((px - pa).norm() < 1.0e-12) && ((py - pb).norm() < 1.0e-12)) || (((px - pb).norm() < 1.0e-12) && ((py - pa).norm() < 1.0e-12))) { continue; }
+        if((((px - ra).norm() < s.tol) && ((py - rb).norm() < s.tol)) || (((px - rb).norm() < s.tol) && ((py - ra).norm() < s.tol))) { return -1; }
+    }
+    return 1;
+}
+static double osSymTerm(const OptCuts::TriMesh& m, int a, int b)
+{
+    const OsSym& s = osSym(m);
+    return s.on ? s.w * osSymStatus(m, a, b) : 0.0;
+}
