+// 2026-11-02 (OneString): optional penalty on seams that bend (env ONESTRING_SEAM_BEND_W, default 0 = original).
+// A new seam edge vI->nbVI costs  length * (1 + w * (1 - cos t)),  t = angle to the straightest existing seam edge
+// ending at vI (no seam at vI: no penalty).  Merges give back the same amount; interior splits use the angle at the
+// middle vertex of the 3-vertex path.
+static double seamBendW(void) { static double w = -1.0; if(w < 0.0) { const char* e = std::getenv("ONESTRING_SEAM_BEND_W"); w = e ? std::atof(e) : 0.0; } return w; }
+static double seamBendFactor(const OptCuts::TriMesh& m, int vI, int nbVI)
+{
+    const double w = seamBendW();
+    if(w <= 0.0) { return 1.0; }
+    Eigen::RowVector3d dNew = m.V_rest.row(nbVI) - m.V_rest.row(vI);
+    if(dNew.norm() < 1.0e-12) { return 1.0; }
+    dNew.normalize();
+    double bestCos = -2.0;
+    for(int c = 0; c < m.cohE.rows(); c++) {
+        if(m.boundaryEdge[c]) { continue; }
+        for(int sI = 0; sI < 2; sI++) {
+            const int a = m.cohE(c, 2 * sI), b = m.cohE(c, 2 * sI + 1);
+            if((a < 0) || (b < 0)) { continue; }
+            int other = -1;
+            if(a == vI) { other = b; } else if(b == vI) { other = a; }
+            if(other < 0 || other == nbVI) { continue; }
+            Eigen::RowVector3d dPrev = m.V_rest.row(vI) - m.V_rest.row(other);
+            if(dPrev.norm() < 1.0e-12 || (m.V_rest.row(other) - m.V_rest.row(nbVI)).norm() < 1.0e-12) { continue; }
+            bestCos = std::max(bestCos, dPrev.normalized().dot(dNew));
+        }
+    }
+    if(bestCos < -1.5) { return 1.0; }
+    return 1.0 + w * (1.0 - bestCos);
