+// a boundary split is only allowed at a boundary vertex that carries no seam edge (a new seam) or at a seam tip
+// (the seam grows); splits in the middle of a seam (a branch) or at a seam mouth (a second seam from the same
+// boundary point) are refused.  The structured grid closes seams with 4 panels only along simple slits.
+static bool osNoBranch(void) { static int f = -1; if(f < 0) { const char* e = std::getenv("ONESTRING_NO_BRANCH"); f = (e && std::atoi(e) != 0) ? 1 : 0; } return f == 1; }
+static bool osBranchingSplit(const OptCuts::TriMesh& m, int vI)
+{
+    if(!osNoBranch()) { return false; }
+    int seamRows = 0;
+    bool onOrigBoundary = false;
+    for(int c = 0; c < m.cohE.rows(); c++) {
+        bool hit = false;
+        for(int k = 0; k < 4; k++) { if(m.cohE(c, k) == vI) { hit = true; } }
+        if(!hit) { continue; }
+        if(m.boundaryEdge[c]) { onOrigBoundary = true; } else { seamRows++; }
+    }
+    if(seamRows == 0) { return false; }                      // plain boundary vertex: starts a new seam
+    if(seamRows == 1 && !onOrigBoundary) { return false; }   // seam tip: the seam grows
+    return true;                                             // middle of a seam or a seam mouth
+}
+static double pathBendFactor(const OptCuts::TriMesh& m, const std::vector<int>& path)
+{
+    const double w = seamBendW();
+    if(w <= 0.0 || path.size() < 3) { return 1.0; }
